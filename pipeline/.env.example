# --- Claude ---
# How to call Claude for the summary:
#   claude-cli (default) = shell out to the `claude` CLI in headless mode, reusing
#                          this machine's Claude Code login (subscription). No API
#                          key, no metered billing. Needs `claude` installed + logged in.
#   api                  = direct Anthropic API call. Metered — requires ANTHROPIC_API_KEY below.
SUMMARY_BACKEND=claude-cli
# Only needed when SUMMARY_BACKEND=api. Leave empty for the claude-cli backend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: path to the `claude` binary if it isn't on PATH (claude-cli backend).
CLAUDE_CLI_PATH=

# --- Notion ---
# Easiest: leave these blank and run the app's "Set up Echo…" onboarding — it
# creates the Calls + Projects databases and fills these in for you.
# Manual: create an internal integration at https://www.notion.so/my-integrations,
# paste its token, share a parent page with it, and let the wizard (or you) create
# the databases. (These are workspace-specific — never commit real ids.)
NOTION_TOKEN=
NOTION_CALLS_DB_ID=
NOTION_PROJECTS_DB_ID=
# Projects whose Status equals this are treated as archived/done and skipped.
# Blank = "Завершён" (default); the onboarding sets "Done" for fresh setups.
PROJECT_DONE_STATUS=

# --- whisper.cpp ---
# Absolute path to the built whisper.cpp CLI binary (whisper-cli, or legacy "main").
WHISPER_CPP_PATH=
# Path to the ggml model file (relative to pipeline/ or absolute).
WHISPER_MODEL=models/ggml-large-v3.bin
# STRONGLY RECOMMENDED: silero VAD model — whisper only transcribes detected speech,
# which kills hallucinations / wrong-language / repetition on quiet or paused audio.
# Get it: ~/whisper.cpp/models/download-vad-model.sh silero-v5.1.2
WHISPER_VAD_MODEL=
# Optional: force a transcription language (ru|uk|en|auto). Default auto.
# Leave "auto" for multilingual calls — the language is then detected per chunk.
WHISPER_LANG=auto
# Transcribe long audio in chunks of N seconds instead of one pass. whisper.cpp
# detects the language once per run and carries decoder context across the whole
# file, so on a long call a single pass can lock every speaker to the language of
# the first 30 seconds and let one repetition loop feed itself to the end of the
# recording. Each chunk gets a fresh context and its own language. 0 = one pass.
WHISPER_CHUNK_SEC=600
# Optional: extra threads for whisper (default: leave empty = whisper default).
WHISPER_THREADS=

# --- Summary ---
# Language of the generated summary: auto | ru | uk | en
# auto = summarize in the dominant language spoken in the meeting.
SUMMARY_LANG=auto

# --- Transcript quality ---
# LLM cleanup pass over the transcript before it is summarized and published:
# restores punctuation/casing in degraded regions, fixes misheard glossary
# terms, collapses leftover repetition loops, and attributes "[Them]" lines to
# named remote participants. The raw whisper transcript is archived to
# ~/Library/Application Support/Echo/raw-transcripts/ before it is replaced.
# on (default) | off
TRANSCRIPT_POLISH=on
# Transcription glossary — names and product terms whisper otherwise garbles
# ("Northwind" -> "Simatrix", "Clerk" -> "Clark"). Fed into the whisper prompt
# and the polish pass. Two optional sources, merged:
#   1) a local file, one term per line and/or comma-separated (see
#      glossary.example.txt); default pipeline/glossary.txt
#   2) a Notion page you edit by hand — set its id here and share the page with
#      the integration. Fetched each run, cached locally for offline runs.
GLOSSARY_PATH=
NOTION_GLOSSARY_PAGE_ID=

# --- Call auto-detect (menu-bar app) ---
# Extra process names that must never count as a call, comma-separated.
# Echo treats any process holding an audio INPUT DEVICE as a call, so an app
# that merely listens (a dictation tool, a meeting assistant) both starts
# phantom recordings and — because the mic never goes free — stops auto-stop
# from ever firing. Echo's own daemons and the sibling Sufler/CallPilot app are
# excluded already; add anything else that squats on the mic here.
# The name to add is printed by: /usr/bin/log show --predicate 'subsystem == "org.leetio.echo"'
DETECT_EXCLUDE=
